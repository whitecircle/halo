# Copy to `.env` (git-ignored) and fill in. `docker run` does not auto-load it: it is passed
# explicitly with `--env-file .env` (see CLAUDE.md) and by the dev container's runArgs. The GPU
# `make` targets pass it via ENV_FILE; the CPU targets pass no credentials at all. `docker compose`
# is the exception — it reads a repo-root `.env` on its own for `${VAR}` interpolation, and the vLLM
# compose file's `training` service also loads it into that container.
#
# Leave a key blank rather than deleting the line: the toolkit reads a set-but-empty value as unset.

# Weights & Biases run logging (halo/entrypoints/run_setup.py).
WANDB_API_KEY=

# Gated HuggingFace model/dataset access.
HF_TOKEN=

# Region for the optional S3 dataset sources — bring your own AWS credentials
# (agent-docs/infrastructure/aws-auth.md). Uncomment only with a value: boto3 takes an empty
# AWS_DEFAULT_REGION as the region itself and fails to build the S3 endpoint.
# AWS_DEFAULT_REGION=

# External LLM keys (judge reward terms, generation scripts) and web-search backends for the RL
# environments, all optional (human-docs/environment-variables.md).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
VLLM_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
KEENABLE_API_KEY=

# Host paths the rollout-server compose files mount, read here or from the shell; neither has a
# fallback. HALO_SCRATCH is a large host volume (findmnt / df -h), which the vLLM file needs even to
# start the server alone. SGLANG_MODEL_DIR is the host directory holding a local SGLANG_MODEL, any
# existing directory for a hub id. `make` does not read this file.
# HALO_SCRATCH=
# SGLANG_MODEL_DIR=

# Rollout servers on other nodes (agent-docs/infrastructure/rollout-servers.md): the trainer address
# the server's workers dial back to for the weight-sync group, and the one address the group's
# rendezvous store listens on (every interface under `HALO_WEIGHT_SYNC_BIND_ALL=1`). IPv4 only.
# Unset = auto (loopback for a same-host server, else this host's address on the route to the server);
# set it when the server cannot dial that address back (NAT, asymmetric routing).
VLLM_GROUP_HOST=
SGLANG_GROUP_HOST=
