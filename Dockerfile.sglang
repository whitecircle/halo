# SGLang server image: `lmsysorg/sglang` plus the training image's exact NCCL wheel, the shared EFA
# userspace (docker/efa/install_efa_userspace.sh) and the source patches below, which together let
# Environmental GRPO broadcast weights into the live engine over a shared NCCL group and score
# prompt log-probs correctly.
# transformers stays at sglang's own pin (transformers==5.19.0), and torch at its 2.14.1, which pairs with the
# trainer's 2.11 over one TCPStore and one NCCL runtime.
# Build: make build-sglang — prebuilt: public.ecr.aws/whitecircle/halo:sglang-0.5.22.

ARG SGLANG_VERSION=0.5.22
FROM lmsysorg/sglang:v${SGLANG_VERSION}

# Static label metadata; the per-build version, date and revision labels are set last.
LABEL maintainer="White Circle <hello@whitecircle.com>"
LABEL org.opencontainers.image.title="Halo SGLang Server"
LABEL org.opencontainers.image.description="SGLang 0.5.22 with NCCL matched to the Halo training image (RL weight sync over /update_weights_from_distributed)"
LABEL org.opencontainers.image.vendor="White Circle"
LABEL org.opencontainers.image.source="https://github.com/whitecircle/halo"
LABEL org.opencontainers.image.licenses="LicenseRef-Halo"

# The Halo-authored patches under /opt ship under the Halo License.
COPY LICENSE APACHE-2.0.txt /opt/halo-license/

# Use the NCCL version from uv.lock so the server matches the training image: a skew hangs the
# weight-sync ncclCommInitRank with no error. `--no-deps` keeps pip off torch.
COPY uv.lock docker/nccl_pin.py /tmp/
RUN NCCL_V=$(python3 /tmp/nccl_pin.py /tmp/uv.lock) \
    && pip install --no-cache-dir "nvidia-nccl-cu13==${NCCL_V}" --no-deps

# The EFA userspace every Halo image shares (the installer owns the pins and why the builds must
# match). The upstream base ships a distro rdma-core and libfabric and no plugin, and NCCL then falls
# back to sockets with no message. `--verify` runs after the script, which rewrites the loader path,
# and checks the wheel and the libnccl.so.2 actually resolved of the two copies present.
COPY docker/efa/install_efa_userspace.sh /tmp/install_efa_userspace.sh
RUN /tmp/install_efa_userspace.sh \
    && rm /tmp/install_efa_userspace.sh \
    && python3 /tmp/nccl_pin.py /tmp/uv.lock --verify \
    && rm /tmp/uv.lock /tmp/nccl_pin.py

# The weight-sync routes, request fields, rendezvous convention and expert loader layouts the client
# relies on (docker/sglang/verify_image.py names why each matters): upstream renames these between
# releases, and a change fails the build instead of a training run.
COPY docker/sglang/verify_image.py /tmp/verify_image.py
RUN python3 /tmp/verify_image.py && rm /tmp/verify_image.py

# The Gemma 4 router caches a derived form of its scale and keeps serving it after an online update
# rewrites the parameter, the GLM-4 gates must keep reading theirs live, and the prefill result loop
# hands a skipped request's input log-probs to the requests after it (docker/sglang/patches/
# patch_sglang.py names each). Its pre- and post-image assertions fail the build on an upstream change,
# and it stays in the image for `--verify`.
COPY docker/engine_source_patch.py docker/sglang/patches/patch_sglang.py /opt/halo/
RUN python3 /opt/halo/patch_sglang.py

# The log-prob rewrite is asserted as text above; this drives the patched loop with a retracted
# request ahead of a live one and fails the build unless the live one reads its own log-probs.
COPY docker/sglang/patches/verify_prefill_logprob_cursor.py /tmp/verify_prefill_logprob_cursor.py
RUN python3 /tmp/verify_prefill_logprob_cursor.py && rm /tmp/verify_prefill_logprob_cursor.py

# Per-build labels, set last: an ARG in scope reaches every later RUN as environment, so a new date or
# commit above the build steps would re-key their cache. make build-sglang passes all three, and
# the base's revision label (its engine's commit) is replaced.
ARG VERSION=1.1.0
ARG BUILD_DATE
ARG SOURCE_REVISION=dev
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
