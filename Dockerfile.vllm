# vLLM 0.32.0 (CUDA 13) server image for RL rollouts and NCCL weight sync (`make build-vllm`). Over
# upstream vllm/vllm-openai it adds the phased weight-sync protocol the trainer drives, the parser
# plugins, R3 routed-experts capture (`--enable-return-routed-experts`, needs `--moe-backend
# triton`), the NCCL wheel at uv.lock's exact pin so both ends load one runtime, and the shared EFA
# userspace. Serving flags and supported families: agent-docs/infrastructure/rollout-servers.md
# transformers and tokenizers stay at the base image's own (transformers==5.19.0), inside the range vLLM
# declares, which the build asserts.

ARG VLLM_VERSION=0.32.0
FROM vllm/vllm-openai:v${VLLM_VERSION}

# Static label metadata; the per-build version, date and revision labels are set last.
LABEL maintainer="White Circle <hello@whitecircle.com>"
LABEL org.opencontainers.image.title="Halo vLLM Server"
LABEL org.opencontainers.image.description="vLLM 0.32.0 (cu13) with NCCL weight transfer + routed-experts capture + tool calling"
LABEL org.opencontainers.image.vendor="White Circle"
LABEL org.opencontainers.image.source="https://github.com/whitecircle/halo"
LABEL org.opencontainers.image.licenses="LicenseRef-Halo"

# The Halo-authored patches/plugins under /opt ship under the Halo License.
COPY LICENSE APACHE-2.0.txt /opt/halo-license/

COPY docker/vllm/patches/patch_vllm_disable_gptoss.sh /tmp/patch_vllm_disable_gptoss.sh
RUN chmod +x /tmp/patch_vllm_disable_gptoss.sh \
    && VLLM_PATH=$(python3 -c "import vllm, os; print(os.path.dirname(vllm.__file__))") \
    && /tmp/patch_vllm_disable_gptoss.sh "$VLLM_PATH" \
    && rm /tmp/patch_vllm_disable_gptoss.sh

COPY docker/vllm/plugins/gpt_oss_text_tool_parser.py /opt/gpt_oss_text_tool_parser.py

COPY docker/vllm/plugins/gpt_oss_reasoning_parser.py /opt/gpt_oss_reasoning_parser.py

# Use the NCCL version from uv.lock so the server matches the training image: a skew hangs the
# weight-sync ncclCommInitRank with no error. `--verify` checks the wheel metadata and the
# libnccl.so.2 a process actually resolves.
COPY uv.lock docker/nccl_pin.py /tmp/
RUN NCCL_V=$(python3 /tmp/nccl_pin.py /tmp/uv.lock) \
    && pip install --no-cache-dir "nvidia-nccl-cu13==${NCCL_V}" --no-deps \
    && python3 /tmp/nccl_pin.py /tmp/uv.lock --verify

# Pin pynccl to that wheel: dlopen would otherwise resolve the base image's older system copy.
ENV VLLM_NCCL_SO_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib/libnccl.so.2
RUN test -f "$VLLM_NCCL_SO_PATH"

# The EFA userspace every Halo image shares (docker/efa/install_efa_userspace.sh owns the pins and
# the reason the builds must match), so the weight-sync group can ride EFA between this container
# and a trainer on another node. The upstream base ships rdma-core but no libfabric or plugin, and
# NCCL then falls back to sockets with no message.
COPY docker/efa/install_efa_userspace.sh /tmp/install_efa_userspace.sh
RUN /tmp/install_efa_userspace.sh && rm /tmp/install_efa_userspace.sh

# Pickle shim: the trainer sends ncclUniqueId as src.distributed.nccl._nccl_wrapper's type, which
# vLLM must unpickle as its own.
RUN mkdir -p /opt/nccl_compat/src/distributed/nccl \
    && touch /opt/nccl_compat/src/__init__.py \
    && touch /opt/nccl_compat/src/distributed/__init__.py \
    && touch /opt/nccl_compat/src/distributed/nccl/__init__.py \
    && echo 'from vllm.distributed.device_communicators.pynccl_wrapper import *' \
       > /opt/nccl_compat/src/distributed/nccl/_nccl_wrapper.py
# Every patch is required: vLLM's layerwise reload puts each layer's tensors on the meta device, so
# layers that write weights with a direct `param.copy_()` revert on every /update_weights; the re-init
# patch destroys the NCCL communicator the engine would otherwise leak per trainer that reconnects
# without a clean shutdown; the two thinking-budget patches let the gpt-oss parser force its whole
# move into the final channel when an analysis channel overruns its budget; and the split top-p guard
# keeps a budget-forced token from being masked with the rest of its row. `sitecustomize` applies
# them in the API server and every engine-core worker.
COPY docker/vllm/patches/vllm_layerwise_reload_patch.py \
     docker/vllm/patches/vllm_weight_transfer_reinit_patch.py \
     docker/vllm/patches/vllm_reasoning_forced_end_patch.py \
     docker/vllm/patches/vllm_thinking_budget_completion_patch.py \
     docker/vllm/patches/vllm_topp_split_guard_patch.py \
     docker/vllm/patches/sitecustomize.py /opt/vllm_patches/
# No `:${PYTHONPATH:-}` tail: it is unset in the base image, so the suffix would render an empty
# sys.path entry (the server's CWD) that a stray module could import-shadow.
ENV PYTHONPATH="/opt/vllm_patches:/opt/nccl_compat"
# Model Runner V2, pinned: it enforces thinking budgets incrementally and is the only runner R3 capture
# runs on, and pinned it fails at startup on a feature it lacks instead of falling back to the V1 runner.
ENV VLLM_USE_V2_MODEL_RUNNER=1

RUN python3 -c "import vllm; print(f'vLLM: {vllm.__version__}')" \
    && python3 -c "from importlib.metadata import requires, version; from packaging.requirements import Requirement; reqs = [r for r in map(Requirement, requires('vllm')) if r.name in ('transformers', 'tokenizers')]; bad = [f'{r.name} {version(r.name)} not in {r.specifier}' for r in reqs if not r.specifier.contains(version(r.name), prereleases=True)]; assert len(reqs) == 2 and not bad, bad or reqs; print('transformers/tokenizers within vLLM requirement:', {r.name: version(r.name) for r in reqs})" \
    && python3 /tmp/nccl_pin.py /tmp/uv.lock --verify \
    && rm /tmp/uv.lock /tmp/nccl_pin.py \
    && python3 -c "from src.distributed.nccl._nccl_wrapper import ncclUniqueId; from vllm.distributed.device_communicators.pynccl_wrapper import ncclUniqueId as v; assert ncclUniqueId is v; print('ncclUniqueId pickle compat: OK')"

# Verify configuration compatibility for each supported model family: every family the weight sync
# admits owes a fixture. Fixtures: docker/vllm/parity/generate.py.
COPY docker/vllm/parity /tmp/parity
RUN python3 /tmp/parity/check.py /tmp/parity && rm -rf /tmp/parity

RUN python3 -c "\
import vllm_layerwise_reload_patch as p; \
from vllm.model_executor.model_loader.reload import layerwise; \
assert p._APPLIED, 'sitecustomize hook did not fire on layerwise import'; \
assert layerwise.restore_layer_on_meta.__module__ == p.__name__, 'restore_layer_on_meta not patched'; \
assert layerwise.initialize_online_processing.__module__ == p.__name__, 'initialize_online_processing not patched'; \
print(f'layerwise reload patch: OK (skips {sorted(p.SKIP_LAYER_NAMES)})')"

# Verify that the reload skip list covers each direct-copy layer, by MRO, in this vLLM version:
# an upstream rename fails the build, not the run.
RUN python3 -c "\
import vllm_layerwise_reload_patch as p; \
from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts; \
from vllm.model_executor.models.gpt_oss import OAIAttention; \
from vllm.model_executor.models.gemma4 import Gemma4Router; \
covered = lambda cls: any(c.__name__ in p.SKIP_LAYER_NAMES for c in cls.__mro__); \
assert covered(RoutedExperts), 'expert-weight owner RoutedExperts not covered by SKIP_LAYER_NAMES'; \
assert covered(OAIAttention), 'sinks owner OAIAttention not covered by SKIP_LAYER_NAMES'; \
assert covered(Gemma4Router), 'Gemma4Router (scale param + root_size buffer) not covered by SKIP_LAYER_NAMES'; \
print('layerwise skip-list coverage: OK (RoutedExperts + OAIAttention + Gemma4Router)')"

# Verify that reinitialization closes the previous NCCL communicator: unpatched, every trainer that
# reconnects without a clean shutdown strands a live one on each engine-core worker until
# ncclCommInitRank fails. The patch leaves shutdown to upstream, which destroys it.
RUN python3 -c "\
import inspect; \
import vllm_weight_transfer_reinit_patch as p; \
from vllm.distributed.weight_transfer.nccl_engine import NCCLWeightTransferEngine as E; \
assert p._APPLIED, 'sitecustomize hook did not fire on nccl_engine import'; \
assert getattr(E.init_transfer_engine, p.PATCH_MARKER, False), 'init_transfer_engine not patched'; \
assert 'self.model_update_group.destroy()' in inspect.getsource(E.shutdown), 'shutdown no longer destroys the communicator'; \
print('weight-transfer re-init patch: OK (communicator destroyed on re-init; upstream shutdown destroys it)')"

# Verify the weight-transfer wire contract the client speaks: the packed geometry rides the init
# request (the engine otherwise receives tensor by tensor while the trainer broadcasts packed
# buffers), an update declares only names, dtypes and shapes, both sides cut chunks at the same byte
# budget, the consumer reuses its streams (per-call streams strand every sync's receive buffers in
# the caching allocator), and the routes exist. Any field change fails here, not as a hung group.
RUN python3 -c "\
import dataclasses, inspect; \
from vllm.distributed.weight_transfer.nccl_engine import NCCLWeightTransferInitInfo as I, NCCLWeightTransferUpdateInfo as U; \
from vllm.distributed.weight_transfer import packed_tensor as pt; \
from vllm.entrypoints.rl.online.api_router import router; \
init = {f.name for f in dataclasses.fields(I)}; \
assert init == {'master_address', 'master_port', 'rank_offset', 'world_size', 'nccl_unique_id_b64', 'packed', 'packed_buffer_size_bytes', 'packed_num_buffers'}, f'init request fields changed: {sorted(init)}'; \
update = {f.name for f in dataclasses.fields(U)}; \
assert update == {'names', 'dtype_names', 'shapes'}, f'update request fields changed: {sorted(update)}'; \
assert (pt.DEFAULT_PACKED_BUFFER_SIZE_BYTES, pt.DEFAULT_PACKED_NUM_BUFFERS) == (1 << 30, 2), 'packed defaults moved'; \
consumer = inspect.getsource(pt.packed_nccl_broadcast_consumer); \
assert '_get_streams(' in consumer and hasattr(pt._get_streams, 'cache_info'), 'packed consumer no longer reuses its streams'; \
assert '> target_packed_tensor_size' in consumer, 'packed consumer changed its chunk boundary'; \
paths = {getattr(r, 'path', None) for r in router.routes}; \
required = {'/pause', '/resume', '/is_paused', '/init_weight_transfer_engine', '/start_weight_update', '/update_weights', '/finish_weight_update', '/get_world_size'}; \
assert required <= paths, f'weight-sync routes lost: {sorted(required - paths)}'; \
print('weight-transfer wire contract: OK')"

# Verify that the thinking-budget patches took: unpatched, a gpt-oss cut stops at the channel token and
# the model picks the channel itself, where an analysis it reopens counts afresh.
RUN python3 -c "\
import vllm_reasoning_forced_end_patch as f, vllm_thinking_budget_completion_patch as c; \
from vllm.config.reasoning import ReasoningConfig; \
from vllm.v1.worker.gpu.sample.thinking_budget import ThinkingBudgetState as T; \
assert f._APPLIED and getattr(ReasoningConfig.initialize_token_ids, f.PATCH_MARKER, False), 'forced-end patch not applied'; \
assert c._APPLIED and all(getattr(getattr(T, n), c.PATCH_MARKER, False) for n in ('__init__', 'apply_staged_writes', 'apply')), 'completion patch not applied'; \
print('thinking-budget patches: OK')"

# Verify the split top-p guard on the Triton interpreter (no GPU here): unpatched, a p-only row of a
# batch of at most 64 whose budget forced a token comes back all -inf, so the engine samples token 0
# with a NaN log-prob. The check also fails once upstream stops wiping that row: drop the patch then.
# The interpreter never reads kernel source, so the rebuilt kernel is also loaded as the compiled
# JITFunction the engine builds; a failure there would only be logged at server start.
RUN CUDA_VISIBLE_DEVICES= TRITON_INTERPRET=1 python3 -c "\
import vllm_topp_split_guard_patch as g; \
from triton.runtime.jit import JITFunction; \
from vllm.v1.sample.ops import topk_topp_triton as t; \
kernel = t._topp_split_mask.kernel; \
assert g._APPLIED and getattr(kernel, g.PATCH_MARKER, False), 'top-p split guard not applied'; \
assert g._GUARD in JITFunction(kernel.fn).src, 'guarded kernel does not load as a compiled Triton kernel'; \
g.self_check(); \
print('top-p split guard: OK (forced row kept, ordinary row masked as upstream, upstream still wipes the forced row)')"

# Verify both parser plugins and the budget they drive during the build: they import vLLM, so no test
# suite covers them. The budget rows run Model Runner V2's Triton kernels on the interpreter (no GPU here).
COPY docker/vllm/plugins/verify_gptoss_plugins.py /tmp/verify_gptoss_plugins.py
RUN CUDA_VISIBLE_DEVICES= TRITON_INTERPRET=1 python3 /tmp/verify_gptoss_plugins.py /opt && rm /tmp/verify_gptoss_plugins.py

# Verify the engine arguments this deployment requires; a rename fails the build, not the run.
# (Dataclass fields, since `vllm serve --help` needs a GPU to infer the platform.)
RUN python3 -c "\
import dataclasses; \
from vllm.engine.arg_utils import EngineArgs; \
names = {f.name for f in dataclasses.fields(EngineArgs)}; \
missing = {'weight_transfer_config', 'enable_return_routed_experts'} - names; \
assert not missing, f'EngineArgs lost: {missing}'; \
from vllm.config.kernel import KernelConfig; \
knames = {f.name for f in dataclasses.fields(KernelConfig)}; \
assert 'moe_backend' in knames, 'KernelConfig.moe_backend gone'; \
print('serve flags: OK')"

# The weight-sync client pauses with `mode=keep` (in-flight requests survive the sync) and leaves
# `clear_cache` at its default, so the pause resets the prefix cache and recomputes every in-flight
# request under the new weights: no KV computed with the old weights is read after a sync. Pinned by
# behaviour, since a keep pause that ignored `clear_cache` would serve that stale KV with no error.
RUN python3 -c "\
import asyncio, inspect, typing; \
from unittest.mock import AsyncMock, MagicMock; \
from vllm.entrypoints.rl.online.api_router import pause_generation; \
from vllm.v1.engine.async_llm import AsyncLLM; \
from vllm.v1.engine.core import EngineCore, EngineCoreProc; \
p = inspect.signature(pause_generation).parameters; \
inner = lambda ann: typing.get_args(ann)[0] if typing.get_origin(ann) is typing.Annotated else ann; \
assert 'mode' in p and 'keep' in typing.get_args(inner(p['mode'].annotation)), '/pause mode no longer accepts keep'; \
assert 'clear_cache' in p and inner(p['clear_cache'].annotation) is bool and p['clear_cache'].default is True, '/pause clear_cache changed'; \
m = MagicMock(); m.renderer.clear_mm_cache_async = AsyncMock(); m.engine_core.pause_scheduler_async = AsyncMock(); \
fwd = lambda clear: (asyncio.run(AsyncLLM.pause_generation(m, mode='keep', clear_cache=clear)), m.engine_core.pause_scheduler_async.await_args.kwargs['clear_cache'])[1]; \
assert fwd(True) is True and fwd(False) is False, 'pause_generation no longer forwards clear_cache under mode=keep'; \
e = MagicMock(); EngineCoreProc.pause_scheduler(e, mode='keep', clear_cache=True); \
assert e._finish_pause.call_args.args == (True,), 'a keep pause no longer finishes with the clear_cache it was given'; \
e = MagicMock(); EngineCore._finish_pause(e, False); assert not e._reset_caches.called, 'clear_cache=false still resets'; \
e = MagicMock(); EngineCore._finish_pause(e, True); assert e._reset_caches.called, 'clear_cache=true no longer resets'; \
e = MagicMock(); EngineCore._reset_caches(e); \
assert e.reset_prefix_cache.call_args.kwargs.get('reset_running_requests') is True, 'pause reset no longer preempts running requests'; \
print('/pause mode=keep + clear_cache: OK')"

# Dev mode exposes the /pause -> /resume phased endpoints the weight-sync client drives. A
# deployment must keep those endpoints off any untrusted network.
ENV VLLM_SERVER_DEV_MODE=1

ENTRYPOINT ["vllm", "serve"]
# Default args; docker-compose overrides CMD with model + args. --moe-backend triton is required
# with weight transfer: the auto-selected Blackwell backends repack the expert weights.
CMD ["--weight-transfer-config", "{\"backend\": \"nccl\"}", "--moe-backend", "triton", "--enable-auto-tool-choice", "--tool-call-parser", "hermes"]

# Per-build labels, set last: an ARG in scope reaches every later RUN as environment, so a new date or
# commit above the build steps would re-key their cache. make build-vllm passes all three, and
# the base's revision label (its engine's commit) is replaced.
ARG VERSION=1.1.0
ARG BUILD_DATE
ARG SOURCE_REVISION=dev
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
