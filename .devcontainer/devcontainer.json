{
    // Dev container that runs the editor INSIDE the prebuilt GPU training image, so Pylance
    // resolves the full env — including flash_attn / deep_ep, which a host interpreter lacks.
    // Mirrors the `docker run` in CLAUDE.md. Blackwell (B200/B300) by default; for Hopper swap
    // the image tag to halo:hopper. The tag is local: `make build-blackwell`, or pull the prebuilt
    // image and retag it (docker tag public.ecr.aws/whitecircle/halo:blackwell halo:blackwell).
    "name": "halo (blackwell)",
    "image": "halo:blackwell",

    // Repo is bind-mounted to /workspace to match the image's working dir and PYTHONPATH.
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

    // The host's large volume, exported as HALO_SCRATCH (resolve it as docker.md's launch recipe does,
    // then confirm with `findmnt` / `df -h`); it mounts at /scratch.
    "initializeCommand": "test -n \"$HALO_SCRATCH\" || { echo 'Export HALO_SCRATCH, the large host volume to mount at /scratch' >&2; exit 1; }",

    // GPU + IPC/ulimit/shm flags, py-spy's ptrace capability, and the repo-root .env (WANDB/HF/AWS
    // keys — not auto-loaded). Create it first: `cp .env.example .env`, else Docker refuses to start.
    // Scratch and AWS creds ride in as `-v` rather than "mounts" (`--mount`), which errors outright
    // when the host path is absent.
    "runArgs": [
        "--gpus", "all",
        "--ipc=host",
        "--ulimit", "memlock=-1",
        "--ulimit", "stack=67108864",
        "--shm-size=128g",
        "--cap-add=SYS_PTRACE",
        "--env-file", "${localWorkspaceFolder}/.env",
        "-v", "${localEnv:HALO_SCRATCH}:/scratch",
        "-v", "${localEnv:HOME}/.aws:/root/.aws"
    ],

    // Caches and toolkit scratch off the small in-container root FS, on the host's HALO_SCRATCH.
    "containerEnv": {
        "HF_HOME": "/scratch/hf",
        "HF_DATASETS_CACHE": "/scratch/hf/datasets",
        "TMPDIR": "/scratch/tmp",
        "HALO_DATA_ROOT": "/scratch",
        "PYTHONPATH": "/workspace"
    },

    "customizations": {
        "vscode": {
            // Deps install into the system interpreter (no venv inside the image).
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python"
            },
            "extensions": [
                "charliermarsh.ruff",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "redhat.vscode-yaml"
            ]
        }
    }
}
