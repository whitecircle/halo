    "output_dropout": 0.0,
    "output_router_logits": false,
    "pad_token_id": 0,
    "rms_norm_eps": 1e-06,
    "rope_parameters": {"rope_theta": 600000.0, "rope_type": "default"},
    "rope_theta": 600000.0,
    "routed_scaling_factor": 2.5,
    "tie_word_embeddings": false,
    "topk_group": 1,
    "use_bias": false,
    "use_cache": true,
