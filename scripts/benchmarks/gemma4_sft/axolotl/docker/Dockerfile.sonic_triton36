# Official Axolotl 0.19.0 (torch 2.13) image with Triton downgraded to 3.6.0: axolotl's KernelsPlugin refuses SonicMoE on
# B300 (sm_103) unless Triton is 3.6.x ("B300 (sm_103) requires Triton 3.6.x, but found 3.7.1"). 3.6.0 is the newest 3.6.x.
FROM axolotlai/axolotl:0.19.0-py3.12-cu130-2.13.0@sha256:b38049f2454ceafc58c7a8269c7b400a75416e15b0f308a33850d48ae11e384d
RUN uv pip install --python /workspace/axolotl-venv/bin/python "triton==3.6.0" "apache-tvm-ffi>=0.1.10,<0.2" && \
    /workspace/axolotl-venv/bin/python -c "import triton, torch; print(triton.__version__, torch.__version__)"
