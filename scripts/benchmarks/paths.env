# Paths and host settings for every benchmark script under scripts/benchmarks/. Source it; no script hardcodes a
# host path. Only BENCH_ROOT is required; every other variable defaults under it or to a standard location.
#
#   BENCH_ROOT      writable working directory: datasets, framework installs, runs, results (~1 TB free).
#   HALO_TREE       Halo checkout to measure                       (default: the repository holding these scripts)
#   HF_CACHE        Hugging Face cache (HF_HOME)                   (default: $HOME/.cache/huggingface)
#   BENCH_SEQ       tokens per row: 2048 (the protocol rows) or a multiple, packed by data/pack_canonical.py
#                                                                  (default: 2048)
#   BENCH_STEPS     optimizer steps per run; tokens/s is timed over steps 6..BENCH_STEPS  (default: 25)
#   BENCH_ROWS      UltraChat source rows the data builders take, in order; the first 512 are the protocol rows
#                                                  (default: 512 at 2048 tokens, 1024 otherwise)
#   BENCH_TMP       scratch space for TMPDIR and compile caches    (default: $BENCH_ROOT/tmp)
#   UV_CACHE_DIR    uv package cache                               (default: $BENCH_ROOT/uv-cache)
#   GPU_FLAGS       how `docker run` attaches the GPUs, via CDI     (default: --device nvidia.com/gpu=all)
#   GPU_LOCK        lock file serializing GPU jobs on one host     (default: $BENCH_ROOT/gpu.lock)
#   SYSTEM_LIB_DIR  host directory with the driver's libcuda.so and libnvidia-ml.so.1, for the host-venv source
#                   builds                                         (default: /usr/lib/x86_64-linux-gnu)
#   NVML_HEADER     nvml.h from any CUDA toolkit, for the AutoModel DeepEP build
#                                                                  (default: /usr/local/cuda/include/nvml.h)
#   HF_TOKEN        read from the caller's environment; never written to disk by these scripts.
#
# Docker runs mount BENCH_ROOT, HF_CACHE and HALO_TREE at the same paths inside the container and pass these
# variables through, so a path means the same thing on the host and in the container.
: "${BENCH_ROOT:?set BENCH_ROOT to a writable working directory (see paths.env)}"
BUNDLE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export BENCH_ROOT BUNDLE
export HALO_TREE="${HALO_TREE:-$(git -C "$BUNDLE" rev-parse --show-toplevel)}"
export HF_CACHE="${HF_CACHE:-$HOME/.cache/huggingface}"
export BENCH_TMP="${BENCH_TMP:-$BENCH_ROOT/tmp}"
export BENCH_SEQ="${BENCH_SEQ:-2048}"
# The protocol rows at BENCH_SEQ tokens: canonical tokens/labels and the matching message lists.
export BENCH_STEPS="${BENCH_STEPS:-25}"
export BENCH_ROWS="${BENCH_ROWS:-$([ "$BENCH_SEQ" = 2048 ] && echo 512 || echo 1024)}"
export BENCH_ROWS_SUFFIX=$([ "$BENCH_ROWS" = 512 ] || echo "_$BENCH_ROWS")
export BENCH_SEQ_SUFFIX=$([ "$BENCH_SEQ" = 2048 ] || echo "_$BENCH_SEQ")
export BENCH_CANON="$BENCH_ROOT/data/canonical_tokens$BENCH_SEQ_SUFFIX.jsonl"
export BENCH_MESSAGES="$BENCH_ROOT/data/messages$BENCH_SEQ_SUFFIX.jsonl"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$BENCH_ROOT/uv-cache}"
export GPU_FLAGS="${GPU_FLAGS:---device nvidia.com/gpu=all}"
export GPU_LOCK="${GPU_LOCK:-$BENCH_ROOT/gpu.lock}"
export SYSTEM_LIB_DIR="${SYSTEM_LIB_DIR:-/usr/lib/x86_64-linux-gnu}"
export NVML_HEADER="${NVML_HEADER:-/usr/local/cuda/include/nvml.h}"
mkdir -p "$BENCH_ROOT" "$BENCH_TMP" "$HF_CACHE"

# `docker run` arguments shared by every containerized run: the path mounts and the variables above.
BENCH_DOCKER_MOUNTS=(-v "$BENCH_ROOT":"$BENCH_ROOT" -v "$HF_CACHE":"$HF_CACHE" -v "$HALO_TREE":"$HALO_TREE"
  -e BENCH_ROOT -e BENCH_SEQ -e BENCH_SEQ_SUFFIX -e BENCH_STEPS -e BENCH_ROWS -e BENCH_ROWS_SUFFIX -e BENCH_CANON -e BENCH_MESSAGES -e BUNDLE -e HALO_TREE -e HF_CACHE -e BENCH_TMP -e UV_CACHE_DIR -e HF_TOKEN
  -e HF_HOME="$HF_CACHE" -e HF_DATASETS_CACHE="$HF_CACHE/datasets" -e TMPDIR="$BENCH_TMP")
[ "$BUNDLE" = "${BUNDLE#"$HALO_TREE"}" ] && BENCH_DOCKER_MOUNTS+=(-v "$BUNDLE":"$BUNDLE")

# render_config <template.yaml> -> prints the path of a copy with ${VAR} references expanded, under
# $BENCH_ROOT/rendered/ (configs carry ${BENCH_ROOT}-style placeholders; YAML itself cannot read the environment).
render_config() {
  local src=$1 out
  out="$BENCH_ROOT/rendered/${src#"$BUNDLE"/}"
  mkdir -p "$(dirname "$out")"
  python3 -c 'import os, sys; open(sys.argv[2], "w").write(os.path.expandvars(open(sys.argv[1]).read()))' "$src" "$out"
  echo "$out"
}
