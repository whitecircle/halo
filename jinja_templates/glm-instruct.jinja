{# --- Single-turn data validation --- #}
{%- set user_count = messages | selectattr("role", "equalto", "user") | list | length -%}
{%- set assistant_count = messages | selectattr("role", "equalto", "assistant") | list | length -%}
{%- if user_count != 1 or assistant_count > 1 -%}
  {{- raise_exception("This template only supports single-turn data (1 user message, 0-1 assistant messages). Found " + user_count|string + " user and " + assistant_count|string + " assistant messages.") -}}
{%- endif -%}

{# --- BOS prefix (matches GLM default chat template) --- #}
[gMASK]<sop>
{#- --- Main message rendering (user & assistant only, no system prompt, thinking disabled) --- -#}
{%- for message in messages -%}
  {%- if message.role == "user" -%}
<|user|>{{ message.content }}
  {%- elif message.role == "assistant" -%}
<|assistant|></think>{{ message.content }}<|endoftext|>
  {%- endif -%}
{%- endfor -%}

{# --- Optional generation prompt kick-off --- #}
{%- if add_generation_prompt -%}
<|assistant|></think>
{%- endif -%}
